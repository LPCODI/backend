SERVER_PORT=8080
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080

# Optional: real KMA forecast. Empty uses cached seasonal fallback.
KMA_SERVICE_KEY=

# Optional: GPT Image high-quality rendering. Empty uses fast 2D fallback.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Neon PostgreSQL. Replace placeholders with values from Neon's Connection details.
SPRING_PROFILES_ACTIVE=neon
DB_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=YOUR_NEON_PASSWORD
DB_POOL_SIZE=5

# Firebase Storage (server-side Admin SDK only)
STORAGE_PROVIDER=firebase
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
